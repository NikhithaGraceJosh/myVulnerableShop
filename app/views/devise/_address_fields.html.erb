<div class="nested-fields">
  
  <div class="form-row">
    <div class="field form-group col-md-4 text-left">
      <%= f.label :street %>
      <%= f.text_field :street, autofocus: true, autocomplete: "street", placeholder: "street", class: "form-control" %>
    </div>
    <div class="field form-group col-md-3 text-left">
      <%= f.label :city %>
      <%=f.text_field :city, autofocus: true, autocomplete: "city",placeholder: "city", class: "form-control" %>
    </div>
    <div class="field form-group col-md-2 text-left">
      <%= f.label :zip %>
      <%= f.text_field :zip, autofocus: true, autocomplete: "zip", placeholder: "zip", class:"form-control" %>
    </div>
    <div class="field form-group col-md-3 text-left">
      <%= link_to_remove_association "Remove address", f %>
    </div>
  </div>
</div>
          