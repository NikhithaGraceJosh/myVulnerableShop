<div class="fixed-top">
  <%= render 'partials/header'%>
</div>
<div class="content-top reset-container">
<div class="reset-content m-3">
<h1 style="font-family:Dancing Script;font-weight:bold">Forgot your password?</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control w-25" %>
  </div>

  <div class="actions">
    <%= f.submit "Send me reset password instructions", class:"mt-3 btn btn-custom" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
</div>
</div>
