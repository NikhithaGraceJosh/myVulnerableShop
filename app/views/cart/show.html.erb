<%= javascript_import_module_tag 'update_cart' %>
<%= javascript_import_module_tag 'place-order' %>
<%= javascript_import_module_tag 'address-cart' %>
<div class="fixed-top">
    <%= render 'partials/header' %>
</div>
<div id="cart-show" class="content-top mx-3">
    <%= render 'partials/flash'%>
   <div id="qloader" class="myLoader text-center" style="display:none"><%= image_tag(url_for("loader.gif"))%></div>
    <div class="outer-div">

        <% if @cart.nil? || @cart.empty? %>
            <div class="text-center empty-cart-container">
                <h1>Cart</h1>
                <%=image_tag("empty-cart.png", :style => "width:200px;height:200px; margin:20px")%>
                <div>                
                <%= link_to "Continue Browsing", products_path%>
                </div>
            </div>
        <% else %>
            
            <div id="error-explanation">
                
            </div>
            <div id = "cart-content" class="table-responsive-sm">
                <%= render partial: 'cart_list' %>
            </div>
            
            
        <% end %>
    </div>
</div>

 
