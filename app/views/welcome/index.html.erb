<%= javascript_import_module_tag 'index' %>
<div id="welcome-index">
	<div class="top-container">
		<h1 style="font-family: 'Dancing Script', cursive; font-weight:bold; font-size: 50px;">Cherries</h1>
		<p style="font-family: 'Dancing Script', cursive;">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. </p>
    </div>

<%= render 'partials/header' %>

<div class="welcome-content">
    <div id="carousel-1" class="carousel slide" data-bs-ride="carousel">
                <ol class="carousel-indicators">
                    <li data-bs-target="#carousel-1" data-bs-slide-to="0" class="active"></li>
                    <li data-bs-target="#carousel-1" data-bs-slide-to="1"></li>
                    <li data-bs-target="#carousel-1" data-bs-slide-to="2"></li>

                </ol>
                <div class="carousel-inner">
                    
                   <div class="carousel-item active">
                        <%= image_tag(url_for("slider1-bg-1.jpg"), class: "d-block w-100", alt: "Slider-img-3") %>
                        
                    </div>
                      
                     <div class="carousel-item">
                        <%= image_tag(url_for("slider1-bg-2.jpg"), class: "d-block w-100", alt: "Slider-img-2") %>
                        
                    </div>
                    <div class="carousel-item">
                        <%= image_tag(url_for("slider1-bg-3.jpg"), class: "d-block w-100", alt: "Slider-img-5") %>
                        
                    </div>
                    
                  
                </div>
                <a class="carousel-control-prev" href="#carousel-1" role="button" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon round-circle-border"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carousel-1" role="button" data-bs-slide="next">
                    <span class="carousel-control-next-icon round-circle-border"></span>
                    <span class="sr-only">Next</span>
                </a>
       </div>
         <!-- end of FIRST Carousel -->
        <div class="row m-5 align-items-center">
            <div class="col-md-6">
                <h2 class="ml-5 mt-5 mb-3" style="font-family:Dancing Script; font-weight:bold;"><%= link_to "Women Collection", filter_by_gender_products_path(:gender => 'Women') %>
                <p><small class="text-muted">Lorem ipsum dolor sit amet.</small></p></h2>
            </div>
            <div class="col-md-6">
            <%= link_to filter_by_gender_products_path(:gender => 'Women') do %>
                <div id="carousel-3" class="carousel slide">

                        <div class="carousel-inner">
                            <div class="carousel-item row g-0 active">
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider3-bg-1.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>
                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider3-bg-2.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>
                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider3-bg-3.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>
                                </div>

                            </div>
                            <div class="carousel-item row g-0" >
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider3-bg-4.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>
                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider3-bg-5.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>
                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider3-bg-6.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>
                                </div>

                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carousel-3" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon round-circle-border"></span>
                            <span class="sr-only">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carousel-3" data-bs-slide="next">
                            <span class="carousel-control-next-icon round-circle-border"></span>
                            <span class="sr-only">Next</span>
                        </button>

                </div>
            <% end %>
            </div>
          <!-- end of SECOND Carousel -->
        </div>
        <div>
           <div class="row m-5">
                <div class="col-md-7">
                    <%= image_tag(url_for("collections-img.jpg"), style: "height:inherit; width:inherit")%>
                </div>
                <div class="col-md-5" style=" position: relative;">
                <div style="position: absolute;top: 50%;left: 50%;transform: translate(-50%, -50%);font-family:Dancing Script;">
                    <h2><%= link_to "Browse Our Collections...", products_path %></h2>
                    <p style="font-family: 'Dancing Script', cursive;">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. </p>
                </div>
            </div>
        </div>
        <div class="row m-5 align-items-center">
            <div class="col-md-6">
                <h2 class="ml-5 mt-5 mb-3" style="font-family:Dancing Script; font-weight:bold;"><%= link_to "Men Collection", filter_by_gender_products_path(:gender => 'Men') %>
                <p><small class="text-muted">Lorem ipsum dolor sit amet.</small></p>
                </h2>
            </div>
            <div class="col-md-6">
            <%= link_to filter_by_gender_products_path(:gender => 'Men') do %>
                <div id="carousel-2" class="carousel slide">

                        <div class="carousel-inner">
                            <div class="carousel-item row g-0 active">
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider2-bg-1.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>

                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider2-bg-2.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>

                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider2-bg-3.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>

                                </div>

                            </div>
                            <div class="carousel-item row g-0" >
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider2-bg-4.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>

                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider2-bg-5.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>

                                </div>
                                <div class="col-sm-4 m-0 p-0">
                                    <%= image_tag(url_for("slider2-bg-6.jpg"), class: "img-fluid w-100 h-100", alt: "Slider-img-1") %>

                                </div>

                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carousel-2" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon round-circle-border"></span>
                            <span class="sr-only">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carousel-2" data-bs-slide="next">
                            <span class="carousel-control-next-icon round-circle-border"></span>
                            <span class="sr-only">Next</span>
                        </button>

                </div>
                <!-- end of THIRD Carousel -->
            <% end %>
            </div>
        </div>
        </div>
</div>
