#!/usr/bin/env ruby
require 'fileutils'

# path to your application root.
APP_ROOT = File.expand_path('..', __dir__)

DB_USER = 'rails'
DB_PASSWORD = 'password'

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

def mysql_reachable?(*extra_args)
  system(*(['mysql'] + extra_args + ['-e', 'SELECT 1;']), out: File::NULL, err: File::NULL)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to setup or update your development environment automatically.
  # This script is idempotent, so that you can run it at anytime and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts '== Installing dependencies =='
  system! 'gem install bundler --conservative'
  system('bundle check') || system!('bundle install')

  puts "\n== Checking for MySQL =="
  unless system('which mysql > /dev/null 2>&1')
    abort <<~MSG

      Couldn't find a `mysql` client on your PATH. Install MySQL (or MariaDB) first, e.g.:
        macOS:  brew install mysql && brew services start mysql
        Ubuntu: sudo apt-get install mysql-server && sudo systemctl start mysql
      Then re-run bin/setup.
    MSG
  end

  puts "\n== Ensuring database user '#{DB_USER}' exists =="
  # config/database.yml expects a `rails`/`password` MySQL user. Create it (idempotently)
  # using whichever admin access is available on this machine.
  grant_sql = <<~SQL
    CREATE USER IF NOT EXISTS '#{DB_USER}'@'localhost' IDENTIFIED BY '#{DB_PASSWORD}';
    GRANT ALL PRIVILEGES ON `myVulnerableShop_%`.* TO '#{DB_USER}'@'localhost';
    FLUSH PRIVILEGES;
  SQL

  if mysql_reachable?('-u', DB_USER, "-p#{DB_PASSWORD}")
    puts "-- '#{DB_USER}' user already works, skipping."
  elsif system('mysql', '-u', 'root', '-e', grant_sql, out: File::NULL, err: File::NULL)
    puts "-- created via 'mysql -u root' (no password)."
  elsif system('sudo', 'mysql', '-e', grant_sql)
    puts "-- created via 'sudo mysql'."
  else
    abort <<~MSG

      Couldn't create the MySQL user '#{DB_USER}'/'#{DB_PASSWORD}' automatically.
      Run this yourself against your MySQL server (as an admin user), then re-run bin/setup:

        CREATE USER IF NOT EXISTS '#{DB_USER}'@'localhost' IDENTIFIED BY '#{DB_PASSWORD}';
        GRANT ALL PRIVILEGES ON `myVulnerableShop_%`.* TO '#{DB_USER}'@'localhost';
        FLUSH PRIVILEGES;
    MSG
  end

  puts "\n== Preparing database =="
  system! 'bin/rails db:prepare'

  puts "\n== Removing old logs and tempfiles =="
  system! 'bin/rails log:clear tmp:clear'

  puts "\n== Setup complete =="
  puts <<~MSG

    Start the app with:
      bin/dev            # Rails server + Dart Sass watcher (recommended)
      bin/rails server   # Rails server only

    Then visit http://localhost:3000 and sign in with the seeded admin account:
      email:    admin@domain.com
      password: password
  MSG
end
